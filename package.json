{
  "name": "english-class-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "ahui",
  "description": "面向高中英语课堂的本地智能备课与离线游戏平台",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "predev": "node scripts/build-builtin-music.mjs && node scripts/build-portable.mjs",
    "dev": "vite --host 127.0.0.1",
    "build:portable": "node scripts/build-portable.mjs",
    "build": "node scripts/build-builtin-music.mjs && node scripts/build-icons.mjs && node scripts/build-portable.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node scripts/build-portable.mjs && tsc --noEmit",
    "test": "node --test scripts/prepare-desktop-distribution.test.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "notices:native": "node scripts/verify-speech-resources.mjs && node scripts/prepare-native-notices.mjs && node scripts/build-source.mjs --desktop && node scripts/prepare-desktop-distribution.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "resources:prepare": "node scripts/release-resources.mjs",
    "sources:portable": "node scripts/build-source.mjs",
    "sources:desktop": "node scripts/build-source.mjs --desktop"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@soundtouchjs/core": "2.1.1",
    "@tanstack/react-query": "^5.104.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "fflate": "0.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "~3.2.7"
  },
  "license": "GPL-3.0-only"
}
